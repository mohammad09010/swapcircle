extends layout

block content
  .hero
    h2 Items (Listings)
    p Browse what’s available to swap. Use search and filters to find something you like.

    form.filters(method="GET", action="/items")
      input(type="text", name="q", value=q, placeholder="Search title or author/artist…")
      select(name="type")
        option(value="" selected=selectedType==="") All types
        option(value="book" selected=selectedType==="book") Books
        option(value="record" selected=selectedType==="record") Records
      button.btn(type="submit") Apply

  .grid.grid-3
    if items.length
      each it in items
        .card
          .row
            img.thumb(src=`/public/images/${it.item_type}.svg` alt=`${it.item_type} thumbnail`)
            .list-left
              h3
                a(href=`/items/${it.item_id}`)= it.title
              p.muted #{it.item_type} · #{it.author_artist}
              if it.owner_name
                p.small Listed by #{it.owner_name}
              if it.condition_note
                p.small Condition: #{it.condition_note}

          .actions
            a.btn.btn-ghost(href=`/items/${it.item_id}`) View details →
            button.btn(type="button" onclick=`openSwapModal(${it.item_id}, ${JSON.stringify(it.title)})`) Swap request
    else
      .card
        h3 No items found
        p.muted Try changing your search.
