extends layout

block content
  .hero
    h2 Items tagged "#{tag.name}"
    p Browse listings in this category.

  .grid.grid-3
    if items.length
      each it in items
        .card
          .row
            img.thumb(src=`/public/images/${it.item_type}.svg` alt=`${it.item_type} thumbnail`)
            .list-left
              h3
                a(href=`/items/${it.item_id}`)= it.title
              p.muted #{it.item_type} · #{it.author_artist}
              if it.condition_note
                p.small Condition: #{it.condition_note}

          .actions
            a.btn.btn-ghost(href=`/items/${it.item_id}`) View →
            button.btn(type="button" onclick=`openSwapModal(${it.item_id}, ${JSON.stringify(it.title)})`) Swap request
    else
      .card
        h3 No items for this tag
        p.muted Try another tag from Tags page.
        .actions
          a.btn.btn-ghost(href="/tags") Back to tags
