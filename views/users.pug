extends layout

block content
  .hero
    h2 Users
    p Browse community members. (Emails are hidden for privacy.)

  .grid.grid-3
    if users.length
      each u in users
        .card
          h3
            a(href=`/users/${u.user_id}`)= u.display_name
          p.muted Items listed: #{u.item_count}
          p.small Joined: #{u.created_at}
          .actions
            a.btn.btn-ghost(href=`/users/${u.user_id}`) View profile →
    else
      .card
        h3 No users found
        p.muted Check DB seed data.
