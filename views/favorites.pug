extends layout
include includes/mixins

block content
  section.page-section
    .section-toolbar
      a.back-link(href='/') ←
      h1 Saved Items
    p.section-lead Items you have hearted across SwapCircle. Tap any card to send a swap request.
    if items.length
      .market-grid
        each item in items
          +itemCard(item, { compact: true })
    else
      .empty-state
        h2 You have not saved any items yet
        p Tap the heart on any item card to bookmark it for later.
        a.btn.btn-primary(href='/items') Browse items
