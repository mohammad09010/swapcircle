extends layout

block content
  .hero
    h2 Swap, don’t waste.
    p Exchange books and records with your community. Browse listings, explore tags, and connect with members.

    .actions
      a.btn(href="/items") Browse items →
      a.btn.btn-ghost(href="/users") See members
      a.btn.btn-ghost(href="/tags") Explore tags

    .badges
      span.badge.good DB: #{dbStatus}
      if serverTime
        span.badge Server time: #{serverTime}

  .grid.grid-2
    .card
      h3 Latest items
      if sampleItems.length
        .list
          each item in sampleItems
            a.list-item(href=`/items/${item.item_id}`)
              .row
                img.thumb(src=`/public/images/${item.item_type}.svg` alt=`${item.item_type} thumbnail`)
                .list-left
                  .list-title= item.title
                  .list-meta #{item.item_type} · #{item.author_artist}
              span.badge View
      else
        p.muted No items found.

    .card
      h3 Quick start
      p.muted Try these pages:
      .list
        a.list-item(href="/items")
          .list-left
            .list-title Browse listings
            .list-meta Books and records
          span.badge Open
        a.list-item(href="/users")
          .list-left
            .list-title Browse users
            .list-meta Community members
          span.badge Open
        a.list-item(href="/tags")
          .list-left
            .list-title Browse tags
            .list-meta Categories like Fantasy, Rock, Jazz
          span.badge Open
