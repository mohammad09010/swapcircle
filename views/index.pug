extends layout
include includes/mixins

block content
  section.page-section.hero-section
    .hero-copy
      h1.hero-title
        | Swap,
        span.hero-title-accent  don’t waste.
      p.hero-text Join our community to swap books and vinyl records. Give your cherished items a second life with fellow enthusiasts.
      .hero-actions
        a.btn.btn-primary(href="/items") Browse Items →
        a.btn.btn-soft(href="/users") See Members
        a.text-link(href="/tags") Explore Tags
    .hero-media
      +imageWithFallback(heroImage, 'SwapCircle hero illustration', '/public/images/placeholders/category-placeholder.svg', 'hero-image')

  if featuredItems.length
    section.page-section
      .section-heading-row
        .section-heading
          h2 Featured Items
          p Hand-picked swaps from trusted community members
        a.text-link(href="/items") Browse all items
      .card-grid.card-grid-home
        each item in featuredItems
          +itemCard(item, { showSwap: false })

  if latestItems.length
    section.page-section
      .section-heading-row
        .section-heading
          h2 Latest Items
          p Recently added treasures waiting for a new home
        a.text-link(href="/items") View Gallery
      .card-grid.card-grid-home
        each item in latestItems
          article.home-item-card
            .home-item-image-wrap
              +imageWithFallback(item.image_path, `${item.title} cover`, '/public/images/placeholders/category-placeholder.svg', 'home-item-image')
              span.item-pill= item.item_type === 'book' ? 'Book' : 'Vinyl'
            .home-item-content
              h3.home-item-title
                a(href=`/items/${item.item_id}`)= item.title
              p.home-item-author= item.author_artist
              p.home-item-location= item.location_text
              a.btn.btn-soft.home-item-action(href=`/items/${item.item_id}`) View Details

  section.page-section.safety-banner
    .safety-banner-icon 🛡
    .safety-banner-copy
      h3 Stay Safe in the Community
      p Meet in public places, don’t share personal details in-app, and report suspicious behaviour. Your safety is our top priority while swapping.
    a.btn.btn-primary(href="/support") Safety Center

  footer.site-footer
    .footer-top
      .footer-branding
        .footer-brand
          .brand
           img.brand-logo(src="/public/images/logo.svg" alt="SwapCircle logo")
           span.brand-text= projectName
        p Building a sustainable community for collectors, readers, and music lovers around the globe.
      .footer-column
        h4 Quick Links
        a(href="/support") How it works
        a(href="/items") Browse items
        a(href="/support") Community rules
      .footer-column
        h4 Support
        a(href="/support") Help Center
        a(href="/support") Privacy Policy
        a(href="/support") Report Issue
    .footer-bottom
      p © 2024 SwapCircle. Built for a circular economy.
