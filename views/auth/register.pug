extends ../layout

block content
  section.page-section.auth-shell
    .auth-card
      .auth-card-header
        h1 Join SwapCircle
        p Create an account to list items, request swaps and grow your community.
      if flashError
        .auth-error= flashError
      form.auth-form(method='POST' action='/auth/register')
        label.form-label(for='display_name') Display name
        input.form-input#display_name(type='text' name='display_name' value=formValues.display_name required minlength='2' maxlength='80')
        label.form-label(for='email') Email
        input.form-input#email(type='email' name='email' value=formValues.email required)
        label.form-label(for='location_text') City (optional)
        input.form-input#location_text(type='text' name='location_text' value=formValues.location_text placeholder='e.g. London, UK' maxlength='120')
        label.form-label(for='password') Password
        input.form-input#password(type='password' name='password' required minlength='8' placeholder='8 characters minimum')
        button.btn.btn-primary.btn-block(type='submit') Create account
      p.auth-switch
        | Already a member?
        |  
        a(href='/auth/login') Sign in
