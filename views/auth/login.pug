extends ../layout

block content
  section.page-section.auth-shell
    .auth-card
      .auth-card-header
        h1 Welcome back
        p Sign in to send swap requests, message members and earn points.
      if flashError
        .auth-error= flashError
      form.auth-form(method='POST' action='/auth/login')
        label.form-label(for='email') Email
        input.form-input#email(type='email' name='email' value=formValues.email required autofocus)
        label.form-label(for='password') Password
        input.form-input#password(type='password' name='password' required minlength='8')
        button.btn.btn-primary.btn-block(type='submit') Sign in
      p.auth-switch
        | New to SwapCircle?
        |  
        a(href='/auth/register') Create an account
      .auth-demo-card
        h4 Demo accounts (Sprint 4)
        ul
          li
            strong sarah@example.com
            |  / Password123!
          li
            strong alex@example.com
            |  / Password123!
          li
            strong david@example.com
            |  / Password123!
