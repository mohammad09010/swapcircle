extends layout
include includes/mixins

block content
  section.page-section
    .section-toolbar
      a.back-link(href='/') ←
      h1 Community Leaderboard
    p.section-lead Top members by points earned through completing swaps, listing items and rating swaps.
    if board.length
      ol.leaderboard-list
        each user in board
          li.leaderboard-row(class=user.rank <= 3 ? `rank-${user.rank}` : '')
            .leaderboard-rank #{user.rank}
            +imageWithFallback(user.avatar_path, user.display_name, '/public/images/placeholders/avatar.svg', 'leaderboard-avatar')
            .leaderboard-body
              h3
                a(href=`/users/${user.user_id}`)= user.display_name
              p.leaderboard-meta #{user.level} • #{user.swaps_completed} swaps • #{user.rating}★
            .leaderboard-points
              strong= user.points
              span pts
    else
      .empty-state
        p Nobody on the leaderboard yet. Be the first!
