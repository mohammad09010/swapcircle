extends layout

block content
  .hero
    h2= user.display_name
    p Joined: #{user.created_at}

  .card
    h3 Listings by this user
    if items.length
      .list
        each it in items
          a.list-item(href=`/items/${it.item_id}`)
            .list-left
              .list-title #{it.title}
              .list-meta #{it.item_type} · #{it.author_artist}
            span.badge View
    else
      p.muted No listings yet.
