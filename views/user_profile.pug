extends layout
include includes/mixins

block content
  section.page-section.profile-page
    .section-toolbar.profile-toolbar
      a.back-link(href='/users') ←
      h1 User Profile
      nav.inline-nav
        a(href='/tags') Explore
        a(href='/my-swaps') Swaps
        a(href='/support') Messages
        a.active(href=`/users/${user.user_id}`) Profile
    .profile-hero-card
      .profile-hero-main
        +imageWithFallback(user.avatar_path, `${user.display_name} avatar`, '/public/images/placeholders/avatar.svg', 'profile-avatar')
        .profile-hero-copy
          h1= user.display_name
          p.profile-meta #{user.joinedLabel} • #{user.location_text || 'Location not specified'}
          p.profile-bio= user.bio
      button.btn.btn-primary(type='button') Message #{user.display_name.split(' ')[0]}
      .profile-stats
        .profile-stat
          strong= user.item_count
          span Items
        .profile-stat
          strong= user.swaps_completed
          span Swaps
        .profile-stat
          strong #{user.rating}★
          span Rating
    .section-heading-row
      h2 Items by #{user.display_name.split(' ')[0]}
      .toolbar-inline
        select
          option Latest First
        a.text-link(href='/items') View all
    if items.length
      .profile-item-grid
        each item in items
          +profileItemCard(item)
      .load-more-wrap
        button.btn.btn-soft(type='button') Load More Items
    else
      .empty-state
        h2 No items listed yet
        p This member has not added any public items yet.
  footer.site-footer
    .footer-top
      .footer-column
        h4 SwapCircle
        p The world’s largest community for swapping books, media, and more. Join thousands of swappers today.
      .footer-column
        h4 Quick Links
        a(href='/support') Safety Guidelines
        a(href='/support') How it Works
        a(href='/support') Community Rules
      .footer-column
        h4 Support
        a(href='/support') Help Center
        a(href='/support') Contact Us
        a(href='/support') Privacy Policy
    .footer-bottom
      p © 2024 SwapCircle. All rights reserved.
