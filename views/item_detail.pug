extends layout

block content
  .hero
    .row
      img.thumb.thumb-lg(src=`/public/images/${item.item_type}.svg` alt=`${item.item_type} thumbnail`)
      .list-left
        h2= item.title
        p #{item.item_type} · #{item.author_artist}

        .badges
          if item.condition_note
            span.badge Condition: #{item.condition_note}
          span.badge Listed: #{item.created_at}
          if item.owner_id
            span.badge
              | Owner:
              a(href=`/users/${item.owner_id}`)  #{item.owner_name}

        .actions
          a.btn.btn-ghost(href="/items") Back to items
          button.btn(type="button" onclick=`openSwapModal(${item.item_id}, ${JSON.stringify(item.title)})`) Swap request

  .grid.grid-2
    .card
      h3 Tags / Categories
      if tags.length
        .badges
          each t in tags
            a.badge(href=`/tags/${t.tag_id}/items`)= t.name
      else
        p.muted No tags assigned yet.

    .card
      h3 Community swap guidance
      p.muted Meet in public places, confirm item condition clearly, and avoid posting private contact details on listings.
      .actions
        a.btn.btn-ghost(href="/tags") Explore tags
        a.btn.btn-ghost(href="/users") View members
