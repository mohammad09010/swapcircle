extends layout
include includes/mixins

block content
  section.page-section.detail-page
    .detail-topbar
      a.back-link(href="/items") ← Back to Items
      .detail-top-actions
        button.icon-btn(type='button' aria-label='Share item') ↗
        button.icon-btn.favorite-toggle(type='button' aria-label='Save item' data-fav=item.item_id) ♡
    .detail-grid
      .detail-gallery-panel
        .detail-main-image-wrap
          +imageWithFallback(item.gallery[0], `${item.title} main image`, '/public/images/placeholders/category-placeholder.svg', 'detail-main-image')
          span.gallery-counter 1 / #{item.gallery.length}
        if item.gallery.length > 1
          .detail-thumbs
            each imagePath, index in item.gallery
              button.detail-thumb(type='button' data-gallery=imagePath class=index === 0 ? 'active' : '')
                +imageWithFallback(imagePath, `${item.title} thumbnail ${index + 1}`, '/public/images/placeholders/category-placeholder.svg', 'detail-thumb-image')
      .detail-info-panel
        .detail-heading-meta
          span.detail-type= item.item_type === 'book' ? 'Book' : 'Vinyl'
          span.detail-condition= item.condition_note
        h1.detail-title= item.title
        p.detail-author by #{item.author_artist}
        if tags.length
          .tag-row
            each tag in tags
              a.tag-chip(href=`/tags/${tag.tag_id}/items`)= tag.name
        .owner-card
          .owner-card-left
            +imageWithFallback(item.avatar_path, item.owner_name, '/public/images/placeholders/avatar.svg', 'owner-avatar')
            .owner-copy
              h3
                a(href=`/users/${item.owner_id}`)= item.owner_name
              p= item.badge_label || 'Trusted community member'
          .owner-card-right
            span.owner-label Location
            strong= item.location_text || item.owner_location || 'Location not specified'
        .owner-stats
          .stat-card
            span.stat-label Posted
            strong= item.relativeDate
          .stat-card
            span.stat-label Swap Success
            strong #{item.rating ? Math.round(item.rating * 20) : 98}%
        .safety-card
          h3 Safety Tips
          ul
            li Meet in a well-lit, public location for the swap.
            li Inspect the item thoroughly before finalizing.
            li Keep communication within SwapCircle.
    if relatedItems.length
      section.related-strip
        h2 Related Picks
        .related-grid
          each related in relatedItems
            a.related-card(href=`/items/${related.item_id}`)
              +imageWithFallback(related.image_path, related.title, '/public/images/placeholders/category-placeholder.svg', 'related-image')
              span= related.title
  footer.site-footer.site-footer-detail
    .footer-top
      .footer-column
        h4 SwapCircle
        p The world’s first social-driven item swapping community.
      .footer-column
        h4 Product
        a(href="/support") How it Works
        a(href="/support") Safe Swapping
        a(href="/support") Mobile App
      .footer-column
        h4 Support
        a(href="/support") Help Center
        a(href="/support") Community Guidelines
        a(href="/support") Contact Us
      .footer-column
        h4 Newsletter
        .newsletter-row
          input(type='email' placeholder='Your email')
          button.btn.btn-primary(type='button') Join
    .footer-bottom
      p © 2024 SwapCircle. All rights reserved.
