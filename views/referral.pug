extends layout

block content
  section.page-section.referral-page
    .section-toolbar
      a.back-link(href='/items') ←
      h1 Invite Friends to SwapCircle
    p.section-lead Share your referral link. When a friend joins and completes their first swap, you both earn bonus points.

    .referral-card
      h2 Your referral code
      .referral-code-display= code
      label.form-label(for='referral-link') Shareable link
      .referral-link-row
        input.form-input#referral-link(type='text' value=link readonly)
        button.btn.btn-primary#copy-button(type='button') Copy link

      .referral-stats
        .referral-stat
          strong= invitesAccepted
          span Friends joined
        .referral-stat
          strong +25
          span Points per accepted invite
        .referral-stat
          strong +10
          span Points awarded to friend

    .referral-share
      h3 Or share directly
      .referral-buttons
        a.btn.btn-soft(href=`https://wa.me/?text=${encodeURIComponent('Join me on SwapCircle: ' + link)}` target='_blank' rel='noopener') WhatsApp
        a.btn.btn-soft(href=`mailto:?subject=Join me on SwapCircle&body=${encodeURIComponent('I am swapping books and records on SwapCircle. Use my link to join: ' + link)}`) Email
        a.btn.btn-soft(href=`https://twitter.com/intent/tweet?text=${encodeURIComponent('Swap, do not waste! Join SwapCircle with me: ' + link)}` target='_blank' rel='noopener') Twitter / X

    .referral-disclaimer
      h4 Fair-use rules
      ul
        li Each friend can only use one referral link.
        li Bonus points are awarded after the friend's first completed swap.
        li Self-referrals are detected and points reversed.

  script.
    document.getElementById("copy-button").addEventListener("click", async function () {
      const input = document.getElementById("referral-link");
      input.select();
      try {
        await navigator.clipboard.writeText(input.value);
        this.textContent = "Copied!";
      } catch (err) {
        document.execCommand("copy");
        this.textContent = "Copied!";
      }
      setTimeout(() => { this.textContent = "Copy link"; }, 2000);
    });
