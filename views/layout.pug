doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title= pageTitle ? `${pageTitle} | ${projectName}` : projectName
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/public/css/style.css")
    script(src="/public/js/theme.js" defer)
    script(src="/public/js/app.js" defer)
  body(class=pageClass || '')
    header.site-header
      .site-header-inner
        .brand.footer-brand-row
          img.brand-logo(src="/public/images/logo.svg" alt="SwapCircle logo")
          span.brand-text= projectName
        nav.site-nav
          a(class=currentPath === '/' ? 'active' : '', href="/") Home
          a(class=currentPath.startsWith('/items') ? 'active' : '', href="/items") Items
          a(class=currentPath.startsWith('/users') ? 'active' : '', href="/users") Users
          a(class=currentPath.startsWith('/tags') ? 'active' : '', href="/tags") Tags
          a(class=currentPath.startsWith('/my-swaps') ? 'active' : '', href="/my-swaps") My Swaps
          a(class=currentPath.startsWith('/support') ? 'active' : '', href="/support") Support
        .site-header-actions
          button.theme-toggle#themeToggle(type="button" aria-label="Toggle theme") ☾
    main.page-shell
      block content
    dialog#swapDialog.swap-dialog
      .swap-dialog-card
        .swap-dialog-visual
          .swap-dialog-icon ↔
          h3 New Proposal
          p Offer one of your items for this trade. Sprint 3 keeps this interaction as a UI-only demo.
        .swap-dialog-content
          button.swap-dialog-close(type="button" onclick="closeSwapModal()" aria-label="Close") ×
          h2 Swap Request
          p.swap-dialog-copy Select the item you'd like to offer for this trade.
          label.modal-label(for="demoSwapItem") Your item to swap
          .modal-select-wrap
            img.modal-select-image(src="/public/images/items/design-systems.jpg" alt="Demo item" onerror="this.onerror=null;this.src='/public/images/placeholders/category-placeholder.svg'")
            select#demoSwapItem(name="demoSwapItem")
              option(value="Polaroid Go Camera") Polaroid Go Camera
              option(value="Minimalist Design Book") Minimalist Design Book
              option(value="Vintage Poetry Collection") Vintage Poetry Collection
          .swap-dialog-actions
            button.btn.btn-primary(type="button" onclick="confirmSwap()") Send Request
            button.btn.btn-link(type="button" onclick="closeSwapModal()") Cancel
          p.swap-dialog-note The owner usually responds within 24 hours.
    #toast.toast(role="status" aria-live="polite")
