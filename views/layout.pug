doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= projectName
    link(rel="stylesheet", href="/public/css/style.css")
    script(src="/public/js/theme.js" defer)
    script(src="/public/js/app.js" defer)
  body(class="theme-light")
    header.site-header
      .header-inner
        .brand
          h1.site-title= projectName
          p.site-tagline A community book & record swap platform.
        nav.nav
          a(href="/") Home
          a(href="/items") Items
          a(href="/users") Users
          a(href="/tags") Tags
          button#themeToggle(type="button") Dark mode

    main.container
      block content

    // Swap request modal
    dialog#swapDialog
      .modal
        h3 Swap request
        p#swapText We’ll send your swap request to the item owner. (Demo UI only)
        .modal-actions
          button.btn.btn-ghost(type="button" onclick="closeSwapModal()") Cancel
          button.btn(type="button" onclick="confirmSwap()") Send request

    footer.site-footer
      p Safety: meet in public places, don’t share personal details in-app, and report suspicious behaviour to team moderator.
      p © 2026 SwapCircle
