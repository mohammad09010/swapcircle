extends layout
include includes/mixins

block content
  section.page-section.swap-thread-page
    a.back-link(href='/my-swaps') ← Back to all swaps
    .thread-header
      .thread-header-images
        +imageWithFallback(swap.target_image, swap.target_title, '/public/images/placeholders/category-placeholder.svg', 'thread-image')
        span.thread-arrow ↔
        if swap.offered_image
          +imageWithFallback(swap.offered_image, swap.offered_title, '/public/images/placeholders/category-placeholder.svg', 'thread-image')
        else
          .thread-image.thread-image-empty No offer attached
      .thread-header-copy
        h1
          a(href=`/items/${swap.target_item_id}`)= swap.target_title
          if swap.offered_title
            |  ↔ #{swap.offered_title}
        p.thread-subtitle
          | Conversation between 
          strong= swap.requester_name
          |  and 
          strong= swap.owner_name
        span.swap-status(class=`status-${swap.status}`)= swap.status

    if swap.status === 'pending' && isOwner
      .thread-action-bar
        form(method='POST' action=`/my-swaps/${swap.request_id}/accept`)
          button.btn.btn-primary(type='submit') Accept swap
        form(method='POST' action=`/my-swaps/${swap.request_id}/reject`)
          button.btn.btn-soft(type='submit') Decline
    if swap.status === 'pending' && isRequester
      .thread-action-bar
        form(method='POST' action=`/my-swaps/${swap.request_id}/cancel`)
          button.btn.btn-soft(type='submit') Cancel request
    if swap.status === 'accepted'
      .thread-action-bar
        form(method='POST' action=`/my-swaps/${swap.request_id}/complete`)
          button.btn.btn-primary(type='submit') Mark as completed

    .message-list
      if messages.length
        each m in messages
          .message-bubble(class=m.sender_id === currentUser.user_id ? 'message-mine' : 'message-theirs')
            .message-meta
              +imageWithFallback(m.sender_avatar, m.sender_name, '/public/images/placeholders/avatar.svg', 'message-avatar')
              strong= m.sender_name
              span= m.relativeDate
            p.message-body= m.body
      else
        .empty-state.empty-state-soft
          p No messages yet. Say hello!

    if ['pending','accepted','completed'].includes(swap.status)
      form.message-composer(method='POST' action=`/my-swaps/${swap.request_id}/messages`)
        label.form-label(for='body') Send a message
        textarea.form-input#body(name='body' rows='3' maxlength='2000' placeholder='Where would you like to meet?' required)
        button.btn.btn-primary(type='submit') Send

    if swap.status === 'completed' && !hasRated
      form.rating-form(method='POST' action=`/my-swaps/${swap.request_id}/rate`)
        h3 Rate this swap
        p Your honest rating helps the community trust each other.
        .star-row
          each n in [1,2,3,4,5]
            label.star-pick
              input(type='radio' name='stars' value=n required)
              span ★ #{n}
        label.form-label(for='comment') Comment (optional)
        textarea.form-input#comment(name='comment' rows='2' maxlength='500')
        button.btn.btn-primary(type='submit') Submit rating
    else if swap.status === 'completed' && hasRated
      .rating-card
        h3 Rating submitted
        p Thanks for closing the loop. You earned points for completing this swap.
