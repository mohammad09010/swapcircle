extends layout

block content
  .hero
    h2 Tags / Categories
    p Explore items by category.

  .grid.grid-3
    if tags.length
      each t in tags
        .card
          h3
            a(href=`/tags/${t.tag_id}/items`)= t.name
          p.muted Browse items with this tag
          p.small Items in category: #{t.item_count}
          .actions
            a.btn.btn-ghost(href=`/tags/${t.tag_id}/items`) Open →
    else
      .card
        h3 No tags found
        p.muted If you added new SQL scripts, reset volumes and rebuild.
